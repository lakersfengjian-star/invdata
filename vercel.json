{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "",
  "buildCommand": "",
  "rewrites": [
    {
      "source": "/",
      "destination": "/site/index.html"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/site/assets/$1"
    },
    {
      "source": "/styles.css",
      "destination": "/site/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/site/app.js"
    },
    {
      "source": "/meta.json",
      "destination": "/site/meta.json"
    }
  ]
}
