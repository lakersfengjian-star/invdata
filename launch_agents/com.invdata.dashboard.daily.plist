<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.invdata.dashboard.daily</string>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__PROJECT_ROOT__/scripts/local_daily_update.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>PYTHONPYCACHEPREFIX</key>
    <string>/tmp/codex-pycache</string>
    <key>MPLCONFIGDIR</key>
    <string>/tmp/matplotlib-cache</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/local_daily_update.out.log</string>

  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/local_daily_update.err.log</string>
</dict>
</plist>
